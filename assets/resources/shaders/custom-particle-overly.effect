// Effect Syntax Guide: https://github.com/cocos-creator/docs-3d/blob/master/zh/material-system/effect-syntax.md

CCEffect %{
  techniques:
    - passes:
      - vert: particle-vs-legacy:lpvs_main
        frag: unlit-fs:frag
        rasterizerState:
          cullMode: none
        depthStencilState:
          depthTest: true
          depthWrite: false
        blendState:
          targets:
          - blend: true
            blendSrc: src_alpha
            blendDst: one
            blendSrcAlpha: src_alpha
            blendDstAlpha: one
        properties: 
          mainTexture: { value: white }
          mainTiling_Offset:      { value: [1, 1, 0, 0]  }
}%

CCProgram unlit-fs %{
  precision highp float;
  #include <output>

  in vec2 uv;
  in vec4 color;

  uniform sampler2D mainTexture;

  //叠加颜色算法
  float overly(float base, float blend, float alpha, float maxAlpha) {
    float result = 1.0;
    if (base <= 0.5) {
      result = 2.0 * base * blend;
    } else {
      result = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
    }

    //计算颜色叠加，只叠加增加部分
    float offset = result - maxAlpha;
    return base + offset * alpha;
  }


  float get_max_val(float a, float b, float c) {
    return max(a, max(b, c));
  }
  float get_min_val(float a, float b, float c) {
    return min(a, min(b, c));
  }

  vec4 frag () {

    vec4 uv_color = texture(mainTexture, uv);
    // vec4 new_color = vec4(1.0, 1.0, 1.0, uv_color.a);

    //取最大值为最小透明度，黑色会被强制透明
    float maxAlpha = get_max_val(uv_color.r, uv_color.g, uv_color.b);
    // new_color = overly(uv_color, color, maxAlpha);

    uv_color.r = overly(uv_color.r, color.r, color.a, maxAlpha);
    uv_color.g = overly(uv_color.g, color.g, color.a, maxAlpha);
    uv_color.b = overly(uv_color.b, color.b, color.a, maxAlpha);

    return CCFragOutput(uv_color);
  }
}%
