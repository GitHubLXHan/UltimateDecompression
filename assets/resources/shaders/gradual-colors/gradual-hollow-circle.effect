// zeros
//挖空中心shader

CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        tex_size:  { value: [100.0, 100.0], editor: {tooltip: "贴图尺寸"} }
        radius:  { value: 50.0, editor: { tooltip: "半径"} }
        fade_size:  { value: 10.0, editor: { tooltip: "渐变大小"} }
        center:  { value: [0.5, 0.5], editor: {tooltip: "中心位置"} }
}%


CCProgram vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec4 a_color;
  out vec4 v_color;

  #if USE_TEXTURE
  in vec2 a_uv0;
  out vec2 v_uv0;
  #endif

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
    pos = cc_matViewProj * cc_matWorld * pos;
    #else
    pos = cc_matViewProj * pos;
    #endif

    v_uv0 = a_uv0;
    v_color = a_color;

    gl_Position = pos;
  }
}%


CCProgram fs %{
  precision highp float;

  #include <alpha-test>
  #include <texture>

  in vec4 v_color;

  #if USE_TEXTURE
  in vec2 v_uv0;
  uniform sampler2D texture;
  #endif

  uniform sampler2D repeat_tex;

  uniform vsufm {
    vec2 tex_size;
    vec2 center;
    float radius;
    float fade_size;
  };


  void main () {
    vec4 col = vec4(1,1,1,1);

    col = texture(texture, v_uv0) * v_color;

    float fade = clamp(fade_size, 0.0, radius);

    float dx = abs(center.x - v_uv0.x) / (1.0 / tex_size.x);
    float dy = abs(center.y - v_uv0.y) / (1.0 / tex_size.y);

    float min_v = radius - fade;
    //距离
    float dst = sqrt(dx * dx + dy * dy);
    //渐变透明度
    float fa = (clamp(dst, min_v, radius) - min_v) * (1.0 / (radius - min_v));

    col.a = col.a * fa;

    #if USE_BGRA
      gl_FragColor = col.bgra;
    #else
      gl_FragColor = col.rgba;
    #endif
  }
  
}%
