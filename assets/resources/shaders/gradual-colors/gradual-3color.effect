CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        begin_color: { 
          value: [1, 1, 1, 1],
          editor: { type: color, tooltip: "起始颜色" }
        }
        begin_pos: { 
          value: 0,
          editor: { slide: true, range: [0, 1], step: 0.01, tooltip: "起始颜色位置"}
        }
        mid_color: { 
          value: [1, 0, 0, 1],
          editor: { type: color, tooltip: "中间颜色" }
        }
        mid_pos: { 
          value: 0.5,
          editor: { slide: true, range: [0, 1], step: 0.01, tooltip: "中间颜色位置"}
        }
        end_color: { 
          value: [0, 0, 1, 1],
          editor: { type: color, tooltip: "结束颜色" }
        }
        end_pos: { 
          value: 1,
          editor: { slide: true, range: [0, 1], step: 0.01, tooltip: "结束颜色位置"}
        }
        angle: { 
          value: 0.0,
          editor: { tooltip: "角度", range: [0.0, 360.0] }
        }
        repeat_tex: { value: black, editor: {tooltip: "叠加贴图" }}
        repeat_tex_tiling: { value: [1, 1, 0, 0], editor: {tooltip: "叠加贴图UV" }}
        repeat_tex_blend: { value: 1, editor: { slide: true, range: [0, 1], step: 0.01, tooltip: "叠加贴图透明度"} }
}%


CCProgram vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec4 a_color;
  out vec4 v_color;

  #if USE_TEXTURE
  in vec2 a_uv0;
  out vec2 v_uv0;
  #endif

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
    pos = cc_matViewProj * cc_matWorld * pos;
    #else
    pos = cc_matViewProj * pos;
    #endif

    #if USE_TEXTURE
    v_uv0 = a_uv0;
    #endif

    v_color = a_color;

    gl_Position = pos;
  }
}%


CCProgram fs %{
  precision highp float;

  #include <alpha-test>
  #include <texture>

  in vec4 v_color;

  #if USE_TEXTURE
  in vec2 v_uv0;
  uniform sampler2D texture;
  #endif

  uniform sampler2D repeat_tex;

  uniform uf {
      vec4 begin_color;
      vec4 mid_color;
      vec4 end_color;
      vec4 repeat_tex_tiling;
      float begin_pos;
      float mid_pos;
      float end_pos;
      float angle;
      float repeat_tex_blend;
  };

  // flat[] sortPos(float a, float b, float c) {
  //   float l[3];
  //   l[0] = a; l[1] = b; l[2] = c;
  //   for (int i = 0; i < 2; i++) {
  //     for (int j = 0; j < 1; j++) {
  //       if (l[j] > l[j+1]) {
  //         int t = l[j];
  //         l[j] = l[j+1];
  //         l[j+1] = t;
  //       }
  //     }
  //   }
  //   return l;
  // }

  void main () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      CCTexture(texture, v_uv0, o);
    #endif

    o *= v_color;

    //换算角度
    float angleInRadians = radians(angle); 
  	float ratio = clamp((v_uv0.y * cos(angleInRadians) + v_uv0.x * sin(angleInRadians)), 0.0, 1.0);
    
    


    
    // float begin = min(begin_pos, min(mid_pos, end_pos));
    // float end = max(begin_pos, max(mid_pos, end_pos));
    // float mid = 0;
    // if (begin != begin_pos && begin != mid_pos) {
    //   mid = end_pos;
    // } else if (end != begin_pos)
    

    //计算中间颜色比例
    float mid_ratio = 0.0;
    if (ratio <= mid_pos) {
      mid_ratio = mid_pos - abs(ratio - mid_pos) / mid_pos * mid_pos;
    } else {
      mid_ratio = mid_pos - abs(ratio - mid_pos) / (1.0 - mid_pos) * mid_pos;
    }

    //计算起始颜色比例
    float beginRatio = step(mid_pos, ratio) * (1.0 - mid_ratio / mid_pos);
    //计算结束颜色比例
    float endRatio = step(ratio, mid_pos) * (1.0 - mid_ratio / mid_pos);

    //叠加贴图采样
    vec2 ruv = repeat_tex_tiling.zw + v_uv0 * repeat_tex_tiling.xy;
    ruv.x = mod(ruv.x, 1.0);
    ruv.y = mod(ruv.y, 1.0);
    vec4 repeat_tex_col = texture(repeat_tex, ruv);
    float blend = repeat_tex_col.a * clamp(repeat_tex_blend, 0.0, 1.0);

    vec4 col = vec4(
      o.r * (begin_color.r * beginRatio + mid_color.r * (mid_ratio / mid_pos) + end_color.r * endRatio),
  		o.g * (begin_color.g * beginRatio + mid_color.g * (mid_ratio / mid_pos) + end_color.g * endRatio),
  		o.b * (begin_color.b * beginRatio + mid_color.b * (mid_ratio / mid_pos) + end_color.b * endRatio),
  		o.a * (begin_color.a * beginRatio + mid_color.a * (mid_ratio / mid_pos) + end_color.a * endRatio)
  	);

    col = col * (1.0 - blend) + (repeat_tex_col * blend);
  
  	gl_FragColor = col;
  }
}%
