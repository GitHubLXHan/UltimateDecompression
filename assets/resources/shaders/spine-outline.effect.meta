        "frag": "\nprecision highp float;\nuniform vec4 cc_time;\nvarying vec2 v_uv0;\nvarying vec4 v_color;\nuniform sampler2D texture;\nuniform float duration;\nuniform float percentA;\nuniform float percentB;\nuniform float outlingRate;\nuniform float outlingSize;\nuniform float rainbow;\nuniform vec4 outlightColor;\nfloat power = 1.6;\nvoid main()\n{\n  float aSum = 0.0;\n  vec2 _uv;\n  vec2 _uv0 = v_uv0;\n  float p = percentA + (percentB - percentA) * (sin(cc_time.x * (1.0 / duration) * 3.141592653589793 ) + 1.0) * 0.5;\n  for(float i = -5.0; i < 5.0; i++){\n    for(float j = -5.0; j < 5.0; j++){\n      _uv = _uv0 + vec2(outlingSize * i, outlingSize * j);\n      vec4 color = texture2D(texture, _uv);\n      float k = (pow(i, 2.0) + pow(j, 2.0)) / 25.0;\n      k = min(k, 1.0);\n      aSum += color.a  * (1.0 - k)* outlingRate * p;\n    }\n  }\n  if(rainbow < 0.5){\n    vec4 col = outlightColor * aSum;\n    gl_FragColor = col;\n    return;\n  }\n  float _angle = 0.0;\n  if(_uv0.x != 0.5){\n    _angle = atan((_uv0.y-0.5)/(_uv0.x-0.5));\n  }\n  float dt = 10.0*cc_time.x;\n  if(dt > 7.0){\n    dt = mod(dt, 7.0);\n  }\n  _angle = _angle + dt*0.2243994752564138;\n  if(_angle > 1.5707963267948966){\n    _angle = _angle - 1.5707963267948966;\n  }\n  vec3 beginColor = vec3(0,0,0);\n  vec3 endColor = vec3(1,1,1);\n  float beginRange = 0.0;\n  float endRange = 0.0;\n  if(_angle<0.0) {\n    if(_angle > -0.6731984257692414){\n      if(_angle > -0.2243994752564138){\n        beginColor = vec3(0.54509804,0.0,1.0);\n        endColor = vec3(1.0,0.0,0.0);\n        beginRange = -0.2243994752564138;\n        endRange = 0.0;\n      }else if(_angle > -0.4487989505128276){\n        beginColor = vec3(0.0,0.0,1.0);\n        endColor = vec3(0.54509804,0.0,1.0);\n        beginRange = -0.4487989505128276;\n        endRange = -0.2243994752564138;\n      }else {\n        beginColor = vec3(0.0,0.49803922,1.0);\n        endColor = vec3(0.0,0.0,1.0);\n        beginRange = -0.6731984257692414;\n  