CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        tintColor: { value: [1.0, 0.0, 0.0, 1.0] }
        effectParams: { value: [0.5, 0.0, 1.0, 1.0] }
}%

CCProgram vs %{
precision highp float;

#include <cc-global>
#include <cc-local>

in vec3 a_position;

#if USE_TEXTURE
in vec2 a_uv0;
out vec2 v_uv0;
#endif

void main () {
    vec4 pos = vec4(a_position, 1.0);

    #if CC_USE_MODEL
        pos = cc_matViewProj * cc_matWorld * pos;
    #else
        pos = cc_matViewProj * pos;
    #endif

    #if USE_TEXTURE
        v_uv0 = a_uv0;
    #endif

    gl_Position = pos;
}
}%

CCProgram fs %{
precision highp float;

#include <texture>

#if USE_TEXTURE
in vec2 v_uv0;
uniform sampler2D texture;
#endif

uniform Params {
    vec4 tintColor;
    vec4 effectParams;
};

void main () {

    vec4 tex = vec4(1.0);

    #if USE_TEXTURE
        CCTexture(texture, v_uv0, tex);
    #endif

float brightness = effectParams.x;

float mask = tex.r;

// 和 Sprite.color 一样
vec3 color = tintColor.rgb * mask;

// 额外提亮，但黑色区域不受影响
color += brightness * mask;

// 防止溢出
color = clamp(color, 0.0, 1.0);

    gl_FragColor = vec4(
        color,
        tex.a
    );
}
}%