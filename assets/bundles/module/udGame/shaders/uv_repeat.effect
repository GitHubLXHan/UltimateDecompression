CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        alphaThreshold: { value: 0.5 }
    - vert: vs
      frag: fs2
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        detailTexture: { value: white }
        showTextureRange: { value: [0.0, 1.0, 0.0, 1.0] }
        uvRange: { value: [1.0, 1.0] }
        showUvRange: { value: [1.0, 1.0] }
        rowUvOffset: { value: [0.0, 0.0] }
        uvMoveSpeed: { value: [0.0, 0.0] }
        brightness: { value: 1.0, editor: { slide: true, range: [0, 2], step: 0.1, tooltip: "后处理亮度"} }
}%


CCProgram vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec4 a_color;
  out vec4 v_color;

  #if USE_TEXTURE
  in vec2 a_uv0;
  out vec2 v_uv0;

  uniform Constant {
    mat4 worldInvertMat;
    vec4 showTextureRange;
    vec2 nodeSize;
    vec2 nodeAnchor;
    vec2 uvRange;
    vec2 showUvRange;
    vec2 rowUvOffset;
    vec2 uvMoveSpeed;
    float brightness;
    float useInvertMat;
  };

  out vec2 v_uv0_fix;
  #endif

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
    pos = cc_matViewProj * cc_matWorld * pos;
    #else
    pos = cc_matViewProj * pos;
    #endif

    #if USE_TEXTURE
    v_uv0 = a_uv0;

    if (useInvertMat > 0.0) {
      vec4 localPos = worldInvertMat * vec4(a_position, 1);
      float uv0FixX = (localPos.x + nodeSize.x * nodeAnchor.x) / nodeSize.x;
      float uv0FixY = 1.0 - (localPos.y + nodeSize.y * nodeAnchor.y) / nodeSize.y;
      v_uv0_fix = vec2(uv0FixX, uv0FixY);
    } else {
      v_uv0_fix = a_uv0;
    }
    #endif

    v_color = a_color;

    gl_Position = pos;
  }
}%


CCProgram fs %{
  precision highp float;

  #include <alpha-test>
  #include <texture>

  in vec4 v_color;

  #if USE_TEXTURE
  in vec2 v_uv0;
  uniform sampler2D texture;

  uniform sampler2D detailTexture;
  uniform Constant {
    mat4 worldInvertMat;
    vec4 showTextureRange;
    vec2 nodeSize;
    vec2 nodeAnchor;
    vec2 uvRange;
    vec2 showUvRange;
    vec2 rowUvOffset;
    vec2 uvMoveSpeed;
    float brightness;
    float useInvertMat;
  };

  in vec2 v_uv0_fix;
  #endif

  void main () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      CCTexture(texture, v_uv0, o);
    #endif

    o *= v_color;

    ALPHA_TEST(o);

    #if USE_BGRA
      gl_FragColor = o.bgra;
    #else
      gl_FragColor = o.rgba;
    #endif
  }
}%

CCProgram fs2 %{
  precision highp float;

  #include <texture>
  #include <cc-global>

  in vec4 v_color;

  #if USE_TEXTURE
  in vec2 v_uv0;
  uniform sampler2D texture;

  uniform sampler2D detailTexture;
  uniform Constant {
    mat4 worldInvertMat;
    vec4 showTextureRange;
    vec2 nodeSize;
    vec2 nodeAnchor;
    vec2 uvRange;
    vec2 showUvRange;
    vec2 rowUvOffset;
    vec2 uvMoveSpeed;
    float brightness;
    float useInvertMat;
  };

  in vec2 v_uv0_fix;
  #endif

  void main () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      if (v_uv0_fix.x < showTextureRange.x || v_uv0_fix.x > showTextureRange.y || v_uv0_fix.y < showTextureRange.z || v_uv0_fix.y > showTextureRange.w) {
        discard;
      }

      vec2 uv0 = v_uv0_fix;
      vec2 moveDis = uvMoveSpeed * cc_time.x;
      uv0 += moveDis;

      float uvWidth = uvRange.x;
      float uvHeight = uvRange.y;
      float showUvWidth = showUvRange.x;
      float showUvHeight = showUvRange.y;

      int tempRow = int(mod(floor(uv0.y / uvHeight), 2.0));
      if (tempRow == 0) {
          uv0 -= vec2(rowUvOffset.y, 0.0);
      } else {
          uv0 -= vec2(rowUvOffset.x, 0.0);
      }

      float curRow = floor(uv0.y / uvHeight);
      float curCol = floor(uv0.x / uvWidth);
      vec2 baseUv = vec2(0.0, 0.0);
      vec2 baseOffset = baseUv - vec2(curCol * uvWidth, curRow * uvHeight);
      // 移动到uv（0，0）点，webgl中原点在左上角
      vec2 uv1 = uv0 + baseOffset;
      if (uv1.x <= showUvWidth && uv1.y <= showUvHeight) {
          // 缩放到[0,1]区间(非2次幂图片不支持纹理repeat)
          vec2 baseScale = vec2(1.0 / showUvWidth, 1.0 / showUvHeight);
          uv1 *= baseScale;
          o = texture2D(detailTexture, uv1);
          o.rgb *= brightness;
      } else {
        discard;
      }
    #endif

    gl_FragColor = o;
  }
}%
